[Unit]
Description=ArchBooster background update checker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# %h expands to the user's home. pipx (and pip --user) place the console
# script in ~/.local/bin, so point straight at it rather than /usr/bin.
ExecStart=%h/.local/bin/archbooster --daemon
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
